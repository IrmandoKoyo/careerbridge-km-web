# =========================================================================
# KONFIGURASI OPTIONAL FIREBASE FIRESTORE (CAREERBRIDGE KELOMPOK 7)
# =========================================================================
# Salin file ini menjadi ".env" saat tes lokal, lalu isi nilai dari
# Firebase Console -> Project Settings -> Your Apps -> Web App SDK config.
# Pada Vercel: Settings -> Environment Variables -> masukkan 6 variabel ini.
# Catatan: Tanpa variabel ini pun website tetap berjalan normal (mode lokal)!

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# URL Folder Utama Google Drive Kelompok 7 (diatur ke "Anyone with the link can view")
VITE_GOOGLE_DRIVE_MAIN_URL=
VITE_GOOGLE_SHEET_LOG_URL=
